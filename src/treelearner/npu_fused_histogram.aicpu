#include "aicpu_api.h"
#define LGBM_AICPU_DEVICE_SOURCE
#include "npu_fused_histogram.h"

// Accumulate selected features in one launch. Every output bin observes rows in
// the exact order supplied by device_row_indices, with FP32 objective values
// widened before addition. The -ffp-contract=off build setting preserves the
// FP64 addition sequence without contraction or reassociation.
extern "C" __global__ __aicpu__ unsigned int LGBMNPUFusedHistogramKernel(
    const int32_t* const* histogram_tiles, const int32_t* device_row_indices,
    const float* gradients, const float* hessians,
    const LGBMNPUFusedHistogramFeature* features, double* output,
    int32_t num_features, int32_t output_features, int64_t count,
    int32_t histogram_rows, int32_t histogram_stride, int32_t tile_width,
    int32_t* completed) {
  for (int32_t feature_index = 0; feature_index < num_features; ++feature_index) {
    const LGBMNPUFusedHistogramFeature& feature = features[feature_index];
    const int32_t* tile = histogram_tiles[feature.tile_index];
    double* gradient_histogram = output +
        static_cast<int64_t>(feature.output_index) * histogram_stride;
    double* hessian_histogram = output +
        static_cast<int64_t>(output_features) * histogram_stride +
        static_cast<int64_t>(feature.output_index) * histogram_stride;
    const int64_t tile_feature_offset =
        static_cast<int64_t>(feature.tile_feature) * histogram_rows;
    const int32_t sentinel = tile_width * histogram_stride;
    for (int64_t row = 0; row < count; ++row) {
      const int32_t source_row = device_row_indices[row];
      const int32_t packed_bin = tile[tile_feature_offset + source_row];
      if (packed_bin == sentinel) continue;
      const int32_t bin = packed_bin - feature.tile_feature * histogram_stride;
      if (bin < 0 || bin >= feature.num_bins - feature.offset) continue;
      gradient_histogram[bin] += static_cast<double>(gradients[source_row]);
      hessian_histogram[bin] += static_cast<double>(hessians[source_row]);
    }
  }
  AscendC::DataStoreBarrier();
  *completed = 1;
  AscendC::DataStoreBarrier();
  return 0;
}
