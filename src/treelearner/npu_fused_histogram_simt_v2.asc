//
// v2: two-launch AI Core SIMT fused histogram.
//
// Differences from v1 (../npu_fused_histogram_simt.asc), in order of impact:
//
//   1. Two launches instead of four. v1 needed scan -> shift -> accumulate ->
//      finalize as four dependent launches because only a host launch boundary
//      gave it a grid-wide barrier. Here:
//        * launch 1 (scan) only produces the per-bin |x| maxima;
//        * launch 2 derives the per-bin exponent itself, accumulates, and the
//          *last block of each feature partition* (atomic ticket + threadfence)
//          converts that partition's partial sums to binary64 and resets the
//          scratch. Partitions are independent, so no global barrier is needed
//          and the finalize is spread over all partitions instead of one block.
//
//   2. UB-resident histogram. Each block owns a 2-D feature-partition x row-lane
//      thread block (blockIdx.x = partition of kF features, blockIdx.y = row
//      chunk, threadIdx.x = feature inside the partition, threadIdx.y = row
//      lane). The 64-bit accumulators live in UB and are updated with
//      asc_atomic_add, i.e. the GPU __shared__ histogram + atomicAdd_block
//      analogue. One cross-block merge per (feature, bin, plane, window) at the
//      end replaces v1's per-element GM int64 atomics.
//
//   3. Row-major binned data. The packed tile matrix is stored as
//      [row][feature] (see npu_runtime_simt.cpp), so the kF lanes of one row
//      read kF contiguous int32 words and the row index, gradient and Hessian
//      are read once per row for all kF features (the lanes broadcast).
//
//   4. Three magnitude windows. A single int64 grid spans ~61 bits of dynamic
//      range, so a bin holding FLT_MAX next to 1/3 could not represent the
//      small value at all (v1 lost it, and the loss surfaced only when the
//      large values cancelled). Every element whose window-k quantization is
//      zero is re-quantized on a grid `shift_gap` bits finer, up to three
//      levels deep; the three exact integer sums are combined with one
//      184-bit-aware round-to-nearest-even conversion (simt_fixed_point.h).
//      For every bin that does not need a finer window the result is bitwise
//      identical to v1.
//
// Precision contract is otherwise v1's: exact integer accumulation, one
// rounding at the end, deterministic and independent of block/thread order.

#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"
#include "simt_api/device_sync_functions.h"

#include "npu_fused_histogram.h"
#include "simt_fixed_point.h"

namespace {

using lgbm_simt::FloatToBits;
using lgbm_simt::HistogramShift;
using lgbm_simt::QuantizeFloat;
using lgbm_simt::StoreDoubleBits;

constexpr uint32_t kFeaturesPerBlock = 4;
constexpr uint32_t kLanes = 64;
constexpr uint32_t kThreads = kFeaturesPerBlock * kLanes;

// Accumulator slot layout: slot = window * 2 + plane (plane 0 = gradient).
constexpr int32_t kWindows = 3;
constexpr int32_t kAccumulatorSlots = kWindows * 2;

__aicore__ static inline uint32_t MagnitudeBits(float x) {
  return FloatToBits(x) & 0x7FFFFFFFu;
}

// Accumulates `q` into a 64-bit counter emulated by one uint32 low word
// (modular) plus one int32 high word (carry), both in UB. Exact for
// |sum| < 2^63. The high word is only touched when it actually changes.
__aicore__ static inline void Accumulate64(__ubuf__ uint32_t* lo,
                                           __ubuf__ int32_t* hi, int64_t q) {
  if (q == 0) return;
  const uint32_t low_delta = static_cast<uint32_t>(static_cast<uint64_t>(q));
  const int32_t high_delta =
      static_cast<int32_t>(static_cast<uint64_t>(q) >> 32);
  const uint32_t old = asc_atomic_add(lo, low_delta);
  const int32_t carry = static_cast<int32_t>(
      (static_cast<uint64_t>(old) + static_cast<uint64_t>(low_delta)) >> 32);
  const int32_t increment = high_delta + carry;
  if (increment != 0) asc_atomic_add(hi, increment);
}

__aicore__ static inline int64_t Join64(uint32_t lo, int32_t hi) {
  return static_cast<int64_t>((static_cast<uint64_t>(static_cast<uint32_t>(hi))
                               << 32) |
                              static_cast<uint64_t>(lo));
}

// ---------------------------------------------------------------------------
// Launch 1: per (used feature, bin, plane) maximum magnitude, as raw
// non-negative FP32 bit patterns. Integer order equals float order for those
// patterns, so a uint32 max is exact.
//
// UB table per block (kF features x STRIDE bins x 2 planes, 8 KB at
// STRIDE=256) is flushed once with GM asc_atomic_max.
// ---------------------------------------------------------------------------
template <int STRIDE>
__global__ __launch_bounds__(kThreads) void v2_scan_kernel(
    const int32_t* row_bins, const int32_t* device_rows,
    const float* gradients, const float* hessians,
    const int32_t* feature_index, int32_t num_used, int32_t num_features,
    int64_t count, int32_t row_chunks, uint32_t* bin_max) {
  __ubuf__ uint32_t mx[2][kFeaturesPerBlock][STRIDE];
  const uint32_t tx = threadIdx.x;
  const uint32_t ty = threadIdx.y;
  for (uint32_t b = ty; b < STRIDE; b += blockDim.y) {
    mx[0][tx][b] = 0u;
    mx[1][tx][b] = 0u;
  }
  asc_syncthreads();

  const int32_t slot =
      static_cast<int32_t>(blockIdx.x) * static_cast<int32_t>(kFeaturesPerBlock) +
      static_cast<int32_t>(tx);
  if (slot < num_used) {
    const int32_t column = feature_index[slot];
    const int64_t start = static_cast<int64_t>(blockIdx.y) * kLanes + ty;
    const int64_t step = static_cast<int64_t>(row_chunks) * kLanes;
    for (int64_t i = start; i < count; i += step) {
      const int32_t row = device_rows[i];
      const int32_t bin =
          row_bins[static_cast<int64_t>(row) * num_features + column];
      if (bin < 0 || bin >= STRIDE) continue;
      asc_atomic_max(&mx[0][tx][bin], MagnitudeBits(gradients[row]));
      asc_atomic_max(&mx[1][tx][bin], MagnitudeBits(hessians[row]));
    }
  }
  asc_syncthreads();

  if (slot < num_used) {
    const int64_t plane = static_cast<int64_t>(num_used) * STRIDE;
    for (uint32_t b = ty; b < STRIDE; b += blockDim.y) {
      const int64_t at = static_cast<int64_t>(slot) * STRIDE + b;
      const uint32_t gradient = mx[0][tx][b];
      const uint32_t hessian = mx[1][tx][b];
      if (gradient != 0u) asc_atomic_max(&bin_max[at], gradient);
      if (hessian != 0u) asc_atomic_max(&bin_max[plane + at], hessian);
    }
  }
}

// ---------------------------------------------------------------------------
// Launch 2: derive the per-bin exponent from the scan maxima, accumulate the
// three windows in UB, merge into the sharded GM partials, and let the last
// block of each feature partition finalize it.
//
// `shift_gap` = 61 - ceil(log2(count)): window k+1 is that many bits finer than
// window k, which keeps every window's integer sum inside int64 (see the
// bound derivation in simt_fixed_point.h).
// ---------------------------------------------------------------------------
template <int STRIDE>
__global__ __launch_bounds__(kThreads) void v2_hist_kernel(
    const int32_t* row_bins, const int32_t* device_rows,
    const float* gradients, const float* hessians,
    const int32_t* feature_index, int32_t num_used, int32_t num_features,
    const int32_t* stored_bins, int64_t count, int32_t row_chunks,
    int32_t shift_gap, uint32_t* bin_max, int32_t* shift, int64_t* partials,
    int32_t* counters, double* output, int32_t histogram_stride) {
  __ubuf__ uint32_t acc_lo[kAccumulatorSlots][kFeaturesPerBlock][STRIDE];
  __ubuf__ int32_t acc_hi[kAccumulatorSlots][kFeaturesPerBlock][STRIDE];
  __ubuf__ int32_t shift_ub[2][kFeaturesPerBlock][STRIDE];
  __ubuf__ int32_t stored_ub[kFeaturesPerBlock];
  __ubuf__ int32_t last_flag[1];

  const uint32_t tx = threadIdx.x;
  const uint32_t ty = threadIdx.y;
  const int32_t slot =
      static_cast<int32_t>(blockIdx.x) * static_cast<int32_t>(kFeaturesPerBlock) +
      static_cast<int32_t>(tx);
  const bool active = slot < num_used;

  // ---- step 1: per-bin exponents, and a UB cache of them ------------------
  if (active) {
    const int32_t column = feature_index[slot];
    const int32_t stored = stored_bins[column];
    stored_ub[tx] = stored;
    const int64_t plane = static_cast<int64_t>(num_used) * STRIDE;
    const int64_t scan_at = static_cast<int64_t>(slot) * STRIDE;
    const int64_t out_at = static_cast<int64_t>(column) * histogram_stride;
    for (uint32_t b = ty; b < STRIDE; b += blockDim.y) {
      int32_t gradient_shift = 0;
      int32_t hessian_shift = 0;
      if (static_cast<int32_t>(b) < stored) {
        gradient_shift = HistogramShift(bin_max[scan_at + b], count);
        hessian_shift = HistogramShift(bin_max[plane + scan_at + b], count);
      }
      shift_ub[0][tx][b] = gradient_shift;
      shift_ub[1][tx][b] = hessian_shift;
      // Redundant across the row chunks of a partition, identical values.
      // The diagnostic buffer only spans `histogram_stride` bins per feature.
      if (static_cast<int32_t>(b) < histogram_stride) {
        shift[2 * (out_at + b)] = gradient_shift;
        shift[2 * (out_at + b) + 1] = hessian_shift;
      }
    }
  } else {
    stored_ub[tx] = 0;
  }

  // ---- step 2: zero the UB accumulators ----------------------------------
  for (uint32_t b = ty; b < STRIDE; b += blockDim.y) {
    for (int32_t s = 0; s < kAccumulatorSlots; ++s) {
      acc_lo[s][tx][b] = 0u;
      acc_hi[s][tx][b] = 0;
    }
  }
  asc_syncthreads();

  // ---- step 3: the row loop ----------------------------------------------
  if (active) {
    const int32_t column = feature_index[slot];
    const int32_t gap2 = 2 * shift_gap;
    const int64_t start = static_cast<int64_t>(blockIdx.y) * kLanes + ty;
    const int64_t step = static_cast<int64_t>(row_chunks) * kLanes;
    for (int64_t i = start; i < count; i += step) {
      const int32_t row = device_rows[i];
      const int32_t bin =
          row_bins[static_cast<int64_t>(row) * num_features + column];
      if (bin < 0 || bin >= STRIDE) continue;

      // Gradient, then Hessian: same three-level routing, unrolled by plane so
      // every UB index is static.
      int32_t base = shift_ub[0][tx][bin];
      int64_t q = QuantizeFloat(gradients[row], base);
      if (q != 0) {
        Accumulate64(&acc_lo[0][tx][bin], &acc_hi[0][tx][bin], q);
      } else {
        q = QuantizeFloat(gradients[row], base + shift_gap);
        if (q != 0) {
          Accumulate64(&acc_lo[2][tx][bin], &acc_hi[2][tx][bin], q);
        } else {
          q = QuantizeFloat(gradients[row], base + gap2);
          if (q != 0) {
            Accumulate64(&acc_lo[4][tx][bin], &acc_hi[4][tx][bin], q);
          }
        }
      }

      base = shift_ub[1][tx][bin];
      q = QuantizeFloat(hessians[row], base);
      if (q != 0) {
        Accumulate64(&acc_lo[1][tx][bin], &acc_hi[1][tx][bin], q);
      } else {
        q = QuantizeFloat(hessians[row], base + shift_gap);
        if (q != 0) {
          Accumulate64(&acc_lo[3][tx][bin], &acc_hi[3][tx][bin], q);
        } else {
          q = QuantizeFloat(hessians[row], base + gap2);
          if (q != 0) {
            Accumulate64(&acc_lo[5][tx][bin], &acc_hi[5][tx][bin], q);
          }
        }
      }
    }
  }
  asc_syncthreads();

  // ---- step 4: one cross-block merge per (feature, bin, plane, window) ----
  if (active) {
    const int64_t plane = static_cast<int64_t>(num_used) * STRIDE;
    for (uint32_t b = ty; b < STRIDE; b += blockDim.y) {
      const int64_t at = static_cast<int64_t>(slot) * STRIDE + b;
      for (int32_t s = 0; s < kAccumulatorSlots; ++s) {
        const int64_t total = Join64(acc_lo[s][tx][b], acc_hi[s][tx][b]);
        if (total != 0) {
          asc_atomic_add(&partials[static_cast<int64_t>(s) * plane + at], total);
        }
      }
    }
  }

  // ---- step 5: the last block of this partition finalizes it -------------
  asc_syncthreads();
  asc_threadfence();
  if (tx == 0u && ty == 0u) {
    const int32_t ticket = asc_atomic_add(counters + blockIdx.x, 1);
    last_flag[0] = (ticket == row_chunks - 1) ? 1 : 0;
  }
  asc_syncthreads();
  if (last_flag[0] == 0) return;

  if (active) {
    const int32_t column = feature_index[slot];
    const int32_t stored = stored_ub[tx];
    const int64_t plane_slots = static_cast<int64_t>(num_used) * STRIDE;
    const int64_t out_plane = static_cast<int64_t>(num_features) * histogram_stride;
    const int64_t out_at = static_cast<int64_t>(column) * histogram_stride;
    const int64_t scan_at = static_cast<int64_t>(slot) * STRIDE;
    for (uint32_t b = ty; b < STRIDE; b += blockDim.y) {
      const int64_t partial_at = static_cast<int64_t>(slot) * STRIDE + b;
      if (static_cast<int32_t>(b) < stored) {
        const int32_t gradient_shift = shift_ub[0][tx][b];
        const int32_t hessian_shift = shift_ub[1][tx][b];
        StoreDoubleBits(
            output + out_at + b,
            lgbm_simt::ScaledWindowsToDoubleBits(
                partials[partial_at], partials[2 * plane_slots + partial_at],
                partials[4 * plane_slots + partial_at], -gradient_shift,
                shift_gap));
        StoreDoubleBits(
            output + out_plane + out_at + b,
            lgbm_simt::ScaledWindowsToDoubleBits(
                partials[plane_slots + partial_at],
                partials[3 * plane_slots + partial_at],
                partials[5 * plane_slots + partial_at], -hessian_shift,
                shift_gap));
      }
      // Reset the scratch for the next call (the buffers are reused).
      for (int32_t s = 0; s < kAccumulatorSlots; ++s) {
        partials[static_cast<int64_t>(s) * plane_slots + partial_at] = 0;
      }
      bin_max[scan_at + b] = 0u;
      bin_max[plane_slots + scan_at + b] = 0u;
    }
  }
  asc_syncthreads();
  if (tx == 0u && ty == 0u) counters[blockIdx.x] = 0;
}

}  // namespace

// ---------------------------------------------------------------------------
// Host launch wrapper (compiled by the ASC compiler, callable from C++).
//
//   kernel_stride     : compile-time UB tile (32/64/128/256), >= histogram_stride
//   shift_gap         : bits between consecutive magnitude windows; the runtime
//                       passes 61 - ceil(log2(count)), which makes the windows
//                       contiguous and keeps every sum inside int64
//   partitions        : ceil(num_used / kFeaturesPerBlock), must match `counters`
// ---------------------------------------------------------------------------
void LGBMNFusedHistogramSimtV2Launch(
    void* stream, const int32_t* row_bins, const int32_t* device_rows,
    const float* gradients, const float* hessians,
    const int32_t* feature_index, const int32_t* stored_bins, uint32_t* bin_max,
    int32_t* shift, int64_t* partials, int32_t* counters, double* output,
    int32_t num_features, int32_t num_used, int64_t count,
    int32_t histogram_stride, int32_t partitions, int32_t row_chunks,
    int32_t kernel_stride, int32_t shift_gap, int32_t window2) {
  (void)window2;  // All three windows are always active; kept for ABI stability.
  if (count <= 0 || num_used <= 0 || num_features <= 0) return;
  aclrtStream acl_stream = static_cast<aclrtStream>(stream);
  const dim3 grid(static_cast<uint32_t>(partitions),
                  static_cast<uint32_t>(row_chunks), 1u);
  const dim3 block(kFeaturesPerBlock, kLanes, 1u);

#define LGBM_V2_LAUNCH(STRIDE)                                                \
  v2_scan_kernel<STRIDE><<<grid, block, 0, acl_stream>>>(                     \
      row_bins, device_rows, gradients, hessians, feature_index, num_used,    \
      num_features, count, row_chunks, bin_max);                              \
  v2_hist_kernel<STRIDE><<<grid, block, 0, acl_stream>>>(                     \
      row_bins, device_rows, gradients, hessians, feature_index, num_used,    \
      num_features, stored_bins, count, row_chunks, shift_gap, bin_max, shift,\
      partials, counters, output, histogram_stride)

  switch (kernel_stride) {
    case 32:
      LGBM_V2_LAUNCH(32);
      break;
    case 64:
      LGBM_V2_LAUNCH(64);
      break;
    case 128:
      LGBM_V2_LAUNCH(128);
      break;
    default:
      LGBM_V2_LAUNCH(256);
      break;
  }
#undef LGBM_V2_LAUNCH
}
