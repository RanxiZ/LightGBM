//
// v2: two-launch AI Core SIMT fused histogram.
//
// Differences from v1 (../npu_fused_histogram_simt.asc), in order of impact:
//
//   1. Two launches instead of four. v1 needed scan -> shift -> accumulate ->
//      finalize as four dependent launches because only a host launch boundary
//      gave it a grid-wide barrier. Here:
//        * launch 1 (scan) only produces the per-bin |x| maxima;
//        * launch 2 derives the per-bin exponent itself, accumulates, and the
//          *last block of each feature partition* (atomic ticket + threadfence)
//          converts that partition's partial sums to binary64 and resets the
//          scratch. Partitions are independent, so no global barrier is needed
//          and the finalize is spread over all partitions instead of one block.
//
//   2. UB-resident histogram. Each block owns a 2-D feature-partition x row-lane
//      thread block (blockIdx.x = partition of kF features, blockIdx.y = row
//      chunk, threadIdx.x = feature inside the partition, threadIdx.y = row
//      lane). The 64-bit accumulators live in UB and are updated with
//      asc_atomic_add, i.e. the GPU __shared__ histogram + atomicAdd_block
//      analogue. One cross-block merge per (feature, bin, plane, window) at the
//      end replaces v1's per-element GM int64 atomics.
//
//   3. Row-major binned data. The packed tile matrix is stored as
//      [row][feature] (see npu_runtime_simt.cpp), so the kF lanes of one row
//      read kF contiguous int32 words and the row index, gradient and Hessian
//      are read once per row for all kF features (the lanes broadcast).
//
//   4. Three magnitude windows. A single int64 grid spans ~61 bits of dynamic
//      range, so a bin holding FLT_MAX next to 1/3 could not represent the
//      small value at all (v1 lost it, and the loss surfaced only when the
//      large values cancelled). Every element whose window-k quantization is
//      zero is re-quantized on a grid `shift_gap` bits finer, up to three
//      levels deep; the three exact integer sums are combined with one
//      184-bit-aware round-to-nearest-even conversion (simt_fixed_point.h).
//      For every bin that does not need a finer window the result is bitwise
//      identical to v1.
//
// Precision contract is otherwise v1's: exact integer accumulation, one
// rounding at the end, deterministic and independent of block/thread order.

#include <cstdint>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_atomic_functions.h"
#include "simt_api/device_sync_functions.h"

#include "npu_fused_histogram.h"
#include "simt_fixed_point.h"

namespace {

using lgbm_simt::FloatToBits;
using lgbm_simt::HistogramShift;
using lgbm_simt::QuantizeFloat;
using lgbm_simt::StoreDoubleBits;

constexpr uint32_t kFeaturesPerBlock = 4;
// Row lanes per block, i.e. warps per block = LANES. The accumulate loop is a
// chain of dependent, uncoalesced gathers (device_rows -> row -> bins/grad/
// hess), so its cost is dominated by memory latency rather than by issue
// slots: widening the block from 4 to 8 warps measures 8-22% faster on the
// large cases. Two shapes are instantiated instead of one because the merged
// kernel is only used for leaves that fit in a single block per partition,
// where the fixed per-block sweep (STRIDE bins) dominates and the narrower
// block wins.
constexpr uint32_t kSyncLanes = 128;   // two-launch scan + histogram
constexpr uint32_t kFusedLanes = 64;   // merged single-launch kernel

// Accumulator slot layout (GM partials): slot = window * 2 + plane, plane 0 =
// gradient. Windows 2 and 3 exist only to catch elements whose coarse-window
// quantization rounds to zero, which never happens for ordinary gradient /
// Hessian data, so they are NOT kept in UB: the rare element does one GM
// int64 atomic on its window slot instead. Only window 1 is UB-resident,
// which cuts the per-block zero/merge/finalize traffic by 3x and the UB
// footprint from ~57 KB to ~24 KB at STRIDE=256.
constexpr int32_t kWindows = 3;
constexpr int32_t kAccumulatorSlots = kWindows * 2;
constexpr int32_t kUbSlots = 2;

__aicore__ static inline uint32_t MagnitudeBits(float x) {
  return FloatToBits(x) & 0x7FFFFFFFu;
}

// Accumulates `q` into a 64-bit counter emulated by one uint32 low word
// (modular) plus one int32 high word (carry), both in UB. Exact for
// |sum| < 2^63. The high word is only touched when it actually changes.
__aicore__ static inline void Accumulate64(__ubuf__ uint32_t* lo,
                                           __ubuf__ int32_t* hi, int64_t q) {
  if (q == 0) return;
  const uint32_t low_delta = static_cast<uint32_t>(static_cast<uint64_t>(q));
  const int32_t high_delta =
      static_cast<int32_t>(static_cast<uint64_t>(q) >> 32);
  const uint32_t old = asc_atomic_add(lo, low_delta);
  const int32_t carry = static_cast<int32_t>(
      (static_cast<uint64_t>(old) + static_cast<uint64_t>(low_delta)) >> 32);
  const int32_t increment = high_delta + carry;
  if (increment != 0) asc_atomic_add(hi, increment);
}

__aicore__ static inline int64_t Join64(uint32_t lo, int32_t hi) {
  return static_cast<int64_t>((static_cast<uint64_t>(static_cast<uint32_t>(hi))
                               << 32) |
                              static_cast<uint64_t>(lo));
}

// ---------------------------------------------------------------------------
// Launch 1: per (used feature, bin, plane) maximum magnitude, as raw
// non-negative FP32 bit patterns. Integer order equals float order for those
// patterns, so a uint32 max is exact.
//
// UB table per block (kF features x STRIDE bins x 2 planes, 8 KB at
// STRIDE=256) is flushed once with GM asc_atomic_max.
//
// Row mapping: one thread per *row*, and every thread visits all
// kFeaturesPerBlock features of that row. The block therefore covers
// kThreads consecutive rows per iteration instead of blockDim.y, so the row
// index, the gradient and the Hessian are loaded once per row and shared by
// the kF feature bodies (a 4x cut in load instructions and in the i64
// row*num_features address arithmetic). All UB indices stay compile-time
// constants because the feature loop is unrolled with literals.
// ---------------------------------------------------------------------------
template <int STRIDE, int LANES>
__global__ __launch_bounds__(kFeaturesPerBlock * LANES) void v2_scan_kernel(
    const int32_t* row_bins, const int32_t* device_rows,
    const float* gradients, const float* hessians,
    const int32_t* feature_index, int32_t num_used, int32_t num_features,
    const int32_t* stored_bins, int64_t count, int32_t row_chunks,
    uint32_t* bin_max) {
  // UB tables are padded to an odd row stride. With a power-of-two stride every
  // feature lane lands in the same UB bank for a given bin (bank == bin % 32),
  // so the hardware serializes the kFeaturesPerBlock lanes of one warp
  // instruction -- on the atomics that is a hidden 4x. Padding by one word
  // spreads the lanes over 4 banks and removes that serialization.
  constexpr uint32_t kUbStride = STRIDE + 1;
  __ubuf__ uint32_t mx[2][kFeaturesPerBlock][kUbStride];
  const uint32_t tx = threadIdx.x;
  const uint32_t ty = threadIdx.y;
  const float* pair = gradients;
  (void)hessians;
  const int32_t slot0 =
      static_cast<int32_t>(blockIdx.x) * static_cast<int32_t>(kFeaturesPerBlock);
  const int32_t slot = slot0 + static_cast<int32_t>(tx);
  const bool active = slot < num_used;
  // `stored` is the exact bound on every bin index this feature can hold
  // (`row_bins` stores `bin - offset`, i.e. [0, stored) or -1), so the two
  // fixed sweeps below stop there instead of at the padded STRIDE. On a
  // 255-bin leaf that is about half the work, paid once per row chunk.
  const int32_t stored = active ? stored_bins[feature_index[slot]] : 0;
  for (uint32_t b = ty; b < static_cast<uint32_t>(stored); b += blockDim.y) {
    mx[0][tx][b] = 0u;
    mx[1][tx][b] = 0u;
  }
  asc_syncthreads();
  // Explicit literals so every `columns[F]` use below is statically indexed
  // (a dynamic index would spill the array to local memory on device).
  int32_t columns[kFeaturesPerBlock];
  columns[0] = (slot0 + 0 < num_used) ? feature_index[slot0 + 0] : -1;
  columns[1] = (slot0 + 1 < num_used) ? feature_index[slot0 + 1] : -1;
  columns[2] = (slot0 + 2 < num_used) ? feature_index[slot0 + 2] : -1;
  columns[3] = (slot0 + 3 < num_used) ? feature_index[slot0 + 3] : -1;

  // lane = 0..kThreads-1 over the whole block, so a block covers kThreads
  // consecutive rows per step and every row is visited exactly once.
  const int32_t lane = static_cast<int32_t>(ty) * static_cast<int32_t>(kFeaturesPerBlock) +
                       static_cast<int32_t>(tx);
  // The four feature lanes of one row are four consecutive words whenever the
  // used features are dense (the normal case). Reading them as one 16-byte
  // vector load turns four requests for the same 32-byte sector into one,
  // halving this pass' sector traffic. Alignment is guaranteed by requiring the
  // block's first column and the row pitch to be multiples of 4; anything else
  // takes the scalar path below, which produces identical results.
  const bool quad_bins =
      columns[0] >= 0 && columns[1] == columns[0] + 1 &&
      columns[2] == columns[0] + 2 && columns[3] == columns[0] + 3 &&
      ((columns[0] & 3) == 0) && ((num_features & 3) == 0);
  {
    constexpr int64_t kBlockRows = static_cast<int64_t>(kFeaturesPerBlock) * LANES;
    const int64_t start = static_cast<int64_t>(blockIdx.y) * kBlockRows + lane;
    const int64_t step = static_cast<int64_t>(row_chunks) * kBlockRows;
    for (int64_t i = start; i < count; i += step) {
      const int32_t row = device_rows[i];
      const int64_t base = static_cast<int64_t>(row) * num_features;
      const uint32_t gb = MagnitudeBits(pair[2 * row]);
      const uint32_t hb = MagnitudeBits(pair[2 * row + 1]);
// Test-then-set: the slot is monotone non-decreasing, so a stale plain load
// can only return a value <= the live one. When it already covers the new
// magnitude the atomic can be skipped without changing the result, which cuts
// the UB atomic traffic from one op per element to roughly one per record
// (log2 of the per-bin element count).
#define LGBM_SCAN_FEATURE(F)                                        \
  if (columns[F] >= 0) {                                            \
    const int32_t bin = row_bins[base + columns[F]];                \
    if (bin >= 0 && bin < STRIDE) {                                 \
      if (mx[0][F][bin] < gb) asc_atomic_max(&mx[0][F][bin], gb);   \
      if (mx[1][F][bin] < hb) asc_atomic_max(&mx[1][F][bin], hb);   \
    }                                                               \
  }
#define LGBM_SCAN_FEATURE_BIN(F, BIN)                                 \
  if ((BIN) >= 0 && (BIN) < STRIDE) {                                 \
    if (mx[0][F][(BIN)] < gb) asc_atomic_max(&mx[0][F][(BIN)], gb);   \
    if (mx[1][F][(BIN)] < hb) asc_atomic_max(&mx[1][F][(BIN)], hb);   \
  }
      if (quad_bins) {
        const int4 quad =
            *reinterpret_cast<const int4*>(row_bins + base + columns[0]);
        LGBM_SCAN_FEATURE_BIN(0, quad.x)
        LGBM_SCAN_FEATURE_BIN(1, quad.y)
        LGBM_SCAN_FEATURE_BIN(2, quad.z)
        LGBM_SCAN_FEATURE_BIN(3, quad.w)
      } else {
        LGBM_SCAN_FEATURE(0)
        LGBM_SCAN_FEATURE(1)
        LGBM_SCAN_FEATURE(2)
        LGBM_SCAN_FEATURE(3)
      }
#undef LGBM_SCAN_FEATURE
#undef LGBM_SCAN_FEATURE_BIN
    }
  }
  asc_syncthreads();

  if (active) {
    const int64_t plane = static_cast<int64_t>(num_used) * STRIDE;
    for (uint32_t b = ty; b < static_cast<uint32_t>(stored); b += blockDim.y) {
      const int64_t at = static_cast<int64_t>(slot) * STRIDE + b;
      const uint32_t gradient = mx[0][tx][b];
      const uint32_t hessian = mx[1][tx][b];
      if (gradient != 0u) asc_atomic_max(&bin_max[at], gradient);
      if (hessian != 0u) asc_atomic_max(&bin_max[plane + at], hessian);
    }
  }
}

// ---------------------------------------------------------------------------
// Launch 2: derive the per-bin exponent from the scan maxima, accumulate the
// three windows in UB, merge into the sharded GM partials, and let the last
// block of each feature partition finalize it.
//
// `shift_gap` = 61 - ceil(log2(count)): window k+1 is that many bits finer than
// window k, which keeps every window's integer sum inside int64 (see the
// bound derivation in simt_fixed_point.h).
// ---------------------------------------------------------------------------
template <int STRIDE, int LANES>
__global__ __launch_bounds__(kFeaturesPerBlock * LANES) void v2_hist_kernel(
    const int32_t* row_bins, const int32_t* device_rows,
    const float* gradients, const float* hessians,
    const int32_t* feature_index, int32_t num_used, int32_t num_features,
    const int32_t* stored_bins, int64_t count, int32_t row_chunks,
    int32_t shift_gap, uint32_t* bin_max, int32_t* shift, int64_t* partials,
    int32_t* counters, double* output, int32_t histogram_stride) {
  constexpr uint32_t kUbStride = STRIDE + 1;  // odd stride: bank spreading
  __ubuf__ uint32_t acc_lo[kUbSlots][kFeaturesPerBlock][kUbStride];
  __ubuf__ int32_t acc_hi[kUbSlots][kFeaturesPerBlock][kUbStride];
  __ubuf__ int32_t shift_ub[2][kFeaturesPerBlock][kUbStride];
  __ubuf__ int32_t stored_ub[kFeaturesPerBlock];
  __ubuf__ int32_t last_flag[1];

  const uint32_t tx = threadIdx.x;
  const uint32_t ty = threadIdx.y;
  const float* pair = gradients;
  (void)hessians;
  const int32_t slot =
      static_cast<int32_t>(blockIdx.x) * static_cast<int32_t>(kFeaturesPerBlock) +
      static_cast<int32_t>(tx);
  const bool active = slot < num_used;

  // ---- step 1: per-bin exponents, and a UB cache of them ------------------
  if (active) {
    const int32_t column = feature_index[slot];
    const int32_t stored = stored_bins[column];
    stored_ub[tx] = stored;
    const int64_t plane = static_cast<int64_t>(num_used) * STRIDE;
    const int64_t scan_at = static_cast<int64_t>(slot) * STRIDE;
    const int64_t out_at = static_cast<int64_t>(column) * histogram_stride;
    for (uint32_t b = ty; b < STRIDE; b += blockDim.y) {
      int32_t gradient_shift = 0;
      int32_t hessian_shift = 0;
      if (static_cast<int32_t>(b) < stored) {
        gradient_shift = HistogramShift(bin_max[scan_at + b], count);
        hessian_shift = HistogramShift(bin_max[plane + scan_at + b], count);
      }
      shift_ub[0][tx][b] = gradient_shift;
      shift_ub[1][tx][b] = hessian_shift;
      // Redundant across the row chunks of a partition, identical values.
      // The diagnostic buffer only spans `histogram_stride` bins per feature.
      if (static_cast<int32_t>(b) < histogram_stride) {
        shift[2 * (out_at + b)] = gradient_shift;
        shift[2 * (out_at + b) + 1] = hessian_shift;
      }
    }
  } else {
    stored_ub[tx] = 0;
  }

  // ---- step 2: zero the UB accumulators ----------------------------------
  for (uint32_t b = ty; b < static_cast<uint32_t>(stored_ub[tx]);
       b += blockDim.y) {
    for (int32_t s = 0; s < kUbSlots; ++s) {
      acc_lo[s][tx][b] = 0u;
      acc_hi[s][tx][b] = 0;
    }
  }
  asc_syncthreads();

  // ---- step 3: the row loop ----------------------------------------------
  if (active) {
    const int32_t column = feature_index[slot];
    const int32_t gap2 = 2 * shift_gap;
    const int64_t plane_slots = static_cast<int64_t>(num_used) * STRIDE;
    const int64_t slot_at = static_cast<int64_t>(slot) * STRIDE;
    const int64_t start = static_cast<int64_t>(blockIdx.y) * LANES + ty;
    const int64_t step = static_cast<int64_t>(row_chunks) * LANES;
    for (int64_t i = start; i < count; i += step) {
      const int32_t row = device_rows[i];
      const int32_t bin =
          row_bins[static_cast<int64_t>(row) * num_features + column];
      if (bin < 0 || bin >= STRIDE) continue;

      // Gradient, then Hessian: same three-level routing, unrolled by plane so
      // every UB index is static.
      const int64_t gm_at = slot_at + bin;
      int32_t shift_base = shift_ub[0][tx][bin];
      int64_t q = QuantizeFloat(pair[2 * row], shift_base);
      if (q != 0) {
        Accumulate64(&acc_lo[0][tx][bin], &acc_hi[0][tx][bin], q);
      } else {
        q = QuantizeFloat(pair[2 * row], shift_base + shift_gap);
        if (q != 0) {
          asc_atomic_add(&partials[2 * plane_slots + gm_at], q);
        } else {
          q = QuantizeFloat(pair[2 * row], shift_base + gap2);
          if (q != 0) {
            asc_atomic_add(&partials[4 * plane_slots + gm_at], q);
          }
        }
      }

      shift_base = shift_ub[1][tx][bin];
      q = QuantizeFloat(pair[2 * row + 1], shift_base);
      if (q != 0) {
        Accumulate64(&acc_lo[1][tx][bin], &acc_hi[1][tx][bin], q);
      } else {
        q = QuantizeFloat(pair[2 * row + 1], shift_base + shift_gap);
        if (q != 0) {
          asc_atomic_add(&partials[3 * plane_slots + gm_at], q);
        } else {
          q = QuantizeFloat(pair[2 * row + 1], shift_base + gap2);
          if (q != 0) {
            asc_atomic_add(&partials[5 * plane_slots + gm_at], q);
          }
        }
      }
    }
  }
  asc_syncthreads();

  // ---- step 4: one cross-block merge per (feature, bin, plane, window) ----
  if (active) {
    const int64_t plane = static_cast<int64_t>(num_used) * STRIDE;
    for (uint32_t b = ty; b < static_cast<uint32_t>(stored_ub[tx]);
         b += blockDim.y) {
      const int64_t at = static_cast<int64_t>(slot) * STRIDE + b;
      for (int32_t s = 0; s < kUbSlots; ++s) {
        const int64_t total = Join64(acc_lo[s][tx][b], acc_hi[s][tx][b]);
        if (total != 0) {
          asc_atomic_add(&partials[static_cast<int64_t>(s) * plane + at], total);
        }
      }
    }
  }

  // ---- step 5: the last block of this partition finalizes it -------------
  asc_syncthreads();
  asc_threadfence();
  if (tx == 0u && ty == 0u) {
    const int32_t ticket = asc_atomic_add(counters + blockIdx.x, 1);
    last_flag[0] = (ticket == row_chunks - 1) ? 1 : 0;
  }
  asc_syncthreads();
  if (last_flag[0] == 0) return;

  if (active) {
    const int32_t column = feature_index[slot];
    const int32_t stored = stored_ub[tx];
    const int64_t plane_slots = static_cast<int64_t>(num_used) * STRIDE;
    const int64_t out_plane = static_cast<int64_t>(num_features) * histogram_stride;
    const int64_t out_at = static_cast<int64_t>(column) * histogram_stride;
    const int64_t scan_at = static_cast<int64_t>(slot) * STRIDE;
    for (uint32_t b = ty; b < static_cast<uint32_t>(stored);
         b += blockDim.y) {
      const int64_t partial_at = static_cast<int64_t>(slot) * STRIDE + b;
      {
        const int32_t gradient_shift = shift_ub[0][tx][b];
        const int32_t hessian_shift = shift_ub[1][tx][b];
        StoreDoubleBits(
            output + out_at + b,
            lgbm_simt::ScaledWindowsToDoubleBits(
                partials[partial_at], partials[2 * plane_slots + partial_at],
                partials[4 * plane_slots + partial_at], -gradient_shift,
                shift_gap));
        StoreDoubleBits(
            output + out_plane + out_at + b,
            lgbm_simt::ScaledWindowsToDoubleBits(
                partials[plane_slots + partial_at],
                partials[3 * plane_slots + partial_at],
                partials[5 * plane_slots + partial_at], -hessian_shift,
                shift_gap));
      }
      // Reset the scratch for the next call (the buffers are reused).
      for (int32_t s = 0; s < kAccumulatorSlots; ++s) {
        partials[static_cast<int64_t>(s) * plane_slots + partial_at] = 0;
      }
      bin_max[scan_at + b] = 0u;
      bin_max[plane_slots + scan_at + b] = 0u;
    }
  }
  asc_syncthreads();
  if (tx == 0u && ty == 0u) counters[blockIdx.x] = 0;
}

// ---------------------------------------------------------------------------
// Merged launch.
//
// The scan launch exists only because the per-bin maximum over the *whole*
// leaf has to be known before any element can be quantized. When the leaf is
// small enough that the host gives the block every row of its feature
// partition (row_chunks == 1) that maximum is a block-local reduction, so the
// barrier the second launch provided is exactly `asc_syncthreads()`:
//
//   * one launch instead of two (one device dispatch less per histogram);
//   * the per-bin maxima never leave UB: no bin_max GM write, no GM read in
//     the exponent step, no reset pass at the end;
//   * one block per partition => no cross-block merge step (the UB
//     accumulators *are* the partition sums), no ticket, no device-wide
//     threadfence, no counters buffer;
//   * the finalize reads the accumulators straight out of UB.
//
// Windows 2 and 3 keep using the GM partials: they are the rare path (only
// elements that vanish in the coarse window) and keeping them out of UB keeps
// the UB footprint at the 24 KB the two-launch kernel already used.
//
// The observables are unchanged: `shift[]` is written exactly as before from
// the same HistogramShift(max, count) derivation, and the output layout,
// stored/omitted-bin handling and reset invariants of `partials` are
// identical.
// ---------------------------------------------------------------------------
template <int STRIDE, int LANES>
__global__ __launch_bounds__(kFeaturesPerBlock * LANES) void v2_fused_kernel(
    const int32_t* row_bins, const int32_t* device_rows,
    const float* gradients, const float* hessians,
    const int32_t* feature_index, int32_t num_used, int32_t num_features,
    const int32_t* stored_bins, int64_t count, int32_t shift_gap,
    int32_t* shift, int64_t* partials, double* output,
    int32_t histogram_stride) {
  // Phase 1 stores the per-bin maximum magnitude (raw non-negative FP32 bit
  // patterns, whose integer order is the float order); phase 2 overwrites the
  // very same slots with the per-bin exponent. One table, two meanings.
  constexpr uint32_t kUbStride = STRIDE + 1;  // odd stride: bank spreading
  __ubuf__ uint32_t bin_table[2][kFeaturesPerBlock][kUbStride];
  __ubuf__ uint32_t acc_lo[kUbSlots][kFeaturesPerBlock][kUbStride];
  __ubuf__ int32_t acc_hi[kUbSlots][kFeaturesPerBlock][kUbStride];
  __ubuf__ int32_t stored_ub[kFeaturesPerBlock];

  const uint32_t tx = threadIdx.x;
  const uint32_t ty = threadIdx.y;
  const float* pair = gradients;
  (void)hessians;
  const int32_t slot0 =
      static_cast<int32_t>(blockIdx.x) * static_cast<int32_t>(kFeaturesPerBlock);
  const int32_t slot = slot0 + static_cast<int32_t>(tx);
  const bool active = slot < num_used;
  const int32_t column = active ? feature_index[slot] : -1;
  // Bounded by `stored`: no row of this feature can use a bin at or above it.
  const int32_t stored = active ? stored_bins[column] : 0;

  int32_t columns[kFeaturesPerBlock];
  columns[0] = (slot0 + 0 < num_used) ? feature_index[slot0 + 0] : -1;
  columns[1] = (slot0 + 1 < num_used) ? feature_index[slot0 + 1] : -1;
  columns[2] = (slot0 + 2 < num_used) ? feature_index[slot0 + 2] : -1;
  columns[3] = (slot0 + 3 < num_used) ? feature_index[slot0 + 3] : -1;

  // ---- phase 1: block-local per-bin maximum (stays in UB) ----------------
  for (uint32_t b = ty; b < static_cast<uint32_t>(stored); b += blockDim.y) {
    bin_table[0][tx][b] = 0u;
    bin_table[1][tx][b] = 0u;
  }
  asc_syncthreads();
  // Same 16-byte bin load as the scan launch: four consecutive feature lanes of
  // one row are one sector, so reading them together halves this pass' sector
  // traffic. Dense-only, alignment-guarded; the scalar path is identical.
  const bool quad_bins =
      columns[0] >= 0 && columns[1] == columns[0] + 1 &&
      columns[2] == columns[0] + 2 && columns[3] == columns[0] + 3 &&
      ((columns[0] & 3) == 0) && ((num_features & 3) == 0);
  {
    // lane = 0..kThreads-1 over the block: kThreads consecutive rows per step,
    // every row of the leaf visited exactly once.
    const int32_t lane = static_cast<int32_t>(ty) * static_cast<int32_t>(kFeaturesPerBlock) +
                         static_cast<int32_t>(tx);
    const int64_t step = static_cast<int64_t>(blockDim.y) *
                         static_cast<int64_t>(kFeaturesPerBlock);
    for (int64_t i = lane; i < count; i += step) {
      const int32_t row = device_rows[i];
      const int64_t base = static_cast<int64_t>(row) * num_features;
      const uint32_t gb = MagnitudeBits(pair[2 * row]);
      const uint32_t hb = MagnitudeBits(pair[2 * row + 1]);
#define LGBM_FUSED_MAX(F)                                           \
  if (columns[F] >= 0) {                                            \
    const int32_t bin = row_bins[base + columns[F]];                \
    if (bin >= 0 && bin < STRIDE) {                                 \
      if (bin_table[0][F][bin] < gb)                                \
        asc_atomic_max(&bin_table[0][F][bin], gb);                  \
      if (bin_table[1][F][bin] < hb)                                \
        asc_atomic_max(&bin_table[1][F][bin], hb);                  \
    }                                                               \
  }
#define LGBM_FUSED_MAX_BIN(F, BIN)                                    \
  if ((BIN) >= 0 && (BIN) < STRIDE) {                                 \
    if (bin_table[0][F][(BIN)] < gb)                                  \
      asc_atomic_max(&bin_table[0][F][(BIN)], gb);                    \
    if (bin_table[1][F][(BIN)] < hb)                                  \
      asc_atomic_max(&bin_table[1][F][(BIN)], hb);                    \
  }
      if (quad_bins) {
        const int4 quad =
            *reinterpret_cast<const int4*>(row_bins + base + columns[0]);
        LGBM_FUSED_MAX_BIN(0, quad.x)
        LGBM_FUSED_MAX_BIN(1, quad.y)
        LGBM_FUSED_MAX_BIN(2, quad.z)
        LGBM_FUSED_MAX_BIN(3, quad.w)
      } else {
        LGBM_FUSED_MAX(0)
        LGBM_FUSED_MAX(1)
        LGBM_FUSED_MAX(2)
        LGBM_FUSED_MAX(3)
      }
#undef LGBM_FUSED_MAX
#undef LGBM_FUSED_MAX_BIN
    }
  }
  asc_syncthreads();

  // ---- phase 2: per-bin exponents, straight from the UB maxima ----------
  if (active) {
    const int64_t out_at = static_cast<int64_t>(column) * histogram_stride;
    for (uint32_t b = ty; b < STRIDE; b += blockDim.y) {
      int32_t gradient_shift = 0;
      int32_t hessian_shift = 0;
      if (static_cast<int32_t>(b) < stored) {
        gradient_shift = HistogramShift(bin_table[0][tx][b], count);
        hessian_shift = HistogramShift(bin_table[1][tx][b], count);
      }
      bin_table[0][tx][b] = static_cast<uint32_t>(gradient_shift);
      bin_table[1][tx][b] = static_cast<uint32_t>(hessian_shift);
      if (static_cast<int32_t>(b) < histogram_stride) {
        shift[2 * (out_at + b)] = gradient_shift;
        shift[2 * (out_at + b) + 1] = hessian_shift;
      }
    }
  } else {
    stored_ub[tx] = 0;
  }

  // ---- phase 3: zero the UB accumulators --------------------------------
  for (uint32_t b = ty; b < static_cast<uint32_t>(stored); b += blockDim.y) {
    for (int32_t s = 0; s < kUbSlots; ++s) {
      acc_lo[s][tx][b] = 0u;
      acc_hi[s][tx][b] = 0;
    }
  }
  asc_syncthreads();

  // ---- phase 4: the row loop (same routing as the two-launch kernel) ----
  if (active) {
    const int32_t column = feature_index[slot];
    const int32_t gap2 = 2 * shift_gap;
    const int64_t plane_slots = static_cast<int64_t>(num_used) * STRIDE;
    const int64_t slot_at = static_cast<int64_t>(slot) * STRIDE;
    const int64_t start = static_cast<int64_t>(ty);
    const int64_t step = static_cast<int64_t>(blockDim.y);
    for (int64_t i = start; i < count; i += step) {
      const int32_t row = device_rows[i];
      const int32_t bin =
          row_bins[static_cast<int64_t>(row) * num_features + column];
      if (bin < 0 || bin >= STRIDE) continue;

      const int64_t gm_at = slot_at + bin;
      int32_t shift_base = static_cast<int32_t>(bin_table[0][tx][bin]);
      int64_t q = QuantizeFloat(pair[2 * row], shift_base);
      if (q != 0) {
        Accumulate64(&acc_lo[0][tx][bin], &acc_hi[0][tx][bin], q);
      } else {
        q = QuantizeFloat(pair[2 * row], shift_base + shift_gap);
        if (q != 0) {
          asc_atomic_add(&partials[2 * plane_slots + gm_at], q);
        } else {
          q = QuantizeFloat(pair[2 * row], shift_base + gap2);
          if (q != 0) {
            asc_atomic_add(&partials[4 * plane_slots + gm_at], q);
          }
        }
      }

      shift_base = static_cast<int32_t>(bin_table[1][tx][bin]);
      q = QuantizeFloat(pair[2 * row + 1], shift_base);
      if (q != 0) {
        Accumulate64(&acc_lo[1][tx][bin], &acc_hi[1][tx][bin], q);
      } else {
        q = QuantizeFloat(pair[2 * row + 1], shift_base + shift_gap);
        if (q != 0) {
          asc_atomic_add(&partials[3 * plane_slots + gm_at], q);
        } else {
          q = QuantizeFloat(pair[2 * row + 1], shift_base + gap2);
          if (q != 0) {
            asc_atomic_add(&partials[5 * plane_slots + gm_at], q);
          }
        }
      }
    }
  }
  asc_syncthreads();

  // ---- phase 5: finalize this partition straight out of UB --------------
  if (active) {
    const int64_t plane_slots = static_cast<int64_t>(num_used) * STRIDE;
    const int64_t out_plane =
        static_cast<int64_t>(num_features) * histogram_stride;
    const int64_t out_at = static_cast<int64_t>(column) * histogram_stride;
    for (uint32_t b = ty; b < static_cast<uint32_t>(stored);
         b += blockDim.y) {
      const int64_t partial_at = static_cast<int64_t>(slot) * STRIDE + b;
      {
        const int32_t gradient_shift = static_cast<int32_t>(bin_table[0][tx][b]);
        const int32_t hessian_shift = static_cast<int32_t>(bin_table[1][tx][b]);
        StoreDoubleBits(
            output + out_at + b,
            lgbm_simt::ScaledWindowsToDoubleBits(
                Join64(acc_lo[0][tx][b], acc_hi[0][tx][b]),
                partials[2 * plane_slots + partial_at],
                partials[4 * plane_slots + partial_at], -gradient_shift,
                shift_gap));
        StoreDoubleBits(
            output + out_plane + out_at + b,
            lgbm_simt::ScaledWindowsToDoubleBits(
                Join64(acc_lo[1][tx][b], acc_hi[1][tx][b]),
                partials[3 * plane_slots + partial_at],
                partials[5 * plane_slots + partial_at], -hessian_shift,
                shift_gap));
      }
      // Keep the shared scratch buffer's invariant for the next call.
      for (int32_t s = 0; s < kAccumulatorSlots; ++s) {
        partials[static_cast<int64_t>(s) * plane_slots + partial_at] = 0;
      }
    }
  }
}

}  // namespace

// ---------------------------------------------------------------------------
// Host launch wrapper (compiled by the ASC compiler, callable from C++).
//
//   kernel_stride     : compile-time UB tile (32/64/128/256), >= histogram_stride
//   shift_gap         : bits between consecutive magnitude windows; the runtime
//                       passes 61 - ceil(log2(count)), which makes the windows
//                       contiguous and keeps every sum inside int64
//   partitions        : ceil(num_used / kFeaturesPerBlock), must match `counters`
// ---------------------------------------------------------------------------
void LGBMNFusedHistogramSimtV2Launch(
    void* stream, const int32_t* row_bins, const int32_t* device_rows,
    const float* gradients, const float* hessians,
    const int32_t* feature_index, const int32_t* stored_bins, uint32_t* bin_max,
    int32_t* shift, int64_t* partials, int32_t* counters, double* output,
    int32_t num_features, int32_t num_used, int64_t count,
    int32_t histogram_stride, int32_t partitions, int32_t row_chunks,
    int32_t kernel_stride, int32_t shift_gap, int32_t window2) {
  (void)window2;  // All three windows are always active; kept for ABI stability.
  if (count <= 0 || num_used <= 0 || num_features <= 0) return;
  aclrtStream acl_stream = static_cast<aclrtStream>(stream);
  const dim3 grid(static_cast<uint32_t>(partitions),
                  static_cast<uint32_t>(row_chunks), 1u);
  const dim3 block(kFeaturesPerBlock, kSyncLanes, 1u);

// `window2` doubles as an internal measurement selector so the scan/histogram
// split can be timed on the device without a rebuild. 1 (the production value
// the runtime passes) runs both launches; the other modes exist only for
// profiling experiments and never change the production path.
#define LGBM_V2_SCAN(STRIDE)                                                  \
  v2_scan_kernel<STRIDE, kSyncLanes><<<grid, block, 0, acl_stream>>>(                     \
      row_bins, device_rows, gradients, hessians, feature_index, num_used,    \
      num_features, stored_bins, count, row_chunks, bin_max)
#define LGBM_V2_HIST(STRIDE)                                                  \
  v2_hist_kernel<STRIDE, kSyncLanes><<<grid, block, 0, acl_stream>>>(                     \
      row_bins, device_rows, gradients, hessians, feature_index, num_used,    \
      num_features, stored_bins, count, row_chunks, shift_gap, bin_max, shift,\
      partials, counters, output, histogram_stride)
#define LGBM_V2_FUSED(STRIDE)                                                 \
  v2_fused_kernel<STRIDE, kFusedLanes><<<fused_grid, fused_block, 0, acl_stream>>>(              \
      row_bins, device_rows, gradients, hessians, feature_index, num_used,    \
      num_features, stored_bins, count, shift_gap, shift, partials, output,   \
      histogram_stride)

  // row_chunks == 1 means one block owns every row of its feature partition,
  // so the per-bin maximum is a block-local reduction and the two launches
  // collapse into one (see v2_fused_kernel). Measurement modes 2-4 keep the
  // split path so the scan/histogram timings stay comparable.
  if (row_chunks == 1 && window2 == 1) {
    const dim3 fused_grid(static_cast<uint32_t>(partitions), 1u, 1u);
    const dim3 fused_block(kFeaturesPerBlock, kFusedLanes, 1u);
    switch (kernel_stride) {
      case 32:
        LGBM_V2_FUSED(32);
        break;
      case 64:
        LGBM_V2_FUSED(64);
        break;
      case 128:
        LGBM_V2_FUSED(128);
        break;
      default:
        LGBM_V2_FUSED(256);
        break;
    }
#undef LGBM_V2_FUSED
    return;
  }

  switch (kernel_stride) {
    case 32:
      LGBM_V2_SCAN(32);
      if (window2 != 2) LGBM_V2_HIST(32);
      if (window2 == 4) LGBM_V2_SCAN(32);
      break;
    case 64:
      LGBM_V2_SCAN(64);
      if (window2 != 2) LGBM_V2_HIST(64);
      if (window2 == 4) LGBM_V2_SCAN(64);
      break;
    case 128:
      LGBM_V2_SCAN(128);
      if (window2 != 2) LGBM_V2_HIST(128);
      if (window2 == 4) LGBM_V2_SCAN(128);
      break;
    default:
      LGBM_V2_SCAN(256);
      if (window2 != 2) LGBM_V2_HIST(256);
      if (window2 == 4) LGBM_V2_SCAN(256);
      break;
  }
#undef LGBM_V2_SCAN
#undef LGBM_V2_HIST
}
